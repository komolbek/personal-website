# Database
DATABASE_URL="postgresql://user:password@localhost:5432/necto_db"

# Telegram enquiry notifications. Both must be set to send; unset simply
# means no notification, never a lost enquiry. The bot only sends.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Overrides the Hub link in those notifications (default https://hub.necto.uz).
# HUB_PUBLIC_URL=""

# Public URLs
NEXT_PUBLIC_SITE_URL="https://necto.uz"
