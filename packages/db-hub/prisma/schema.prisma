// Prisma schema for Necto Hub, the internal company management system.
//
// Deliberately a separate database from the public site and its CMS: business
// records must not share storage with the marketing CMS. There are no foreign
// keys between the two, which is what made the split possible.
//
// Tables stay in a schema named "hub" rather than "public" so the data moved
// across with a plain `pg_dump --schema=hub`, with no rewriting.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]
  output          = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("HUB_DATABASE_URL")
  schemas  = ["hub"]
}

// ============================================================================
// HUB SCHEMA — Internal Business Management Models
// ============================================================================

// --- Enums ---

enum HubUserRole {
  ADMIN
  MANAGER
  VIEWER

  @@schema("hub")
}

enum HubProductStatus {
  ACTIVE
  PARKED
  ARCHIVED

  @@schema("hub")
}

enum HubLeadSource {
  WALK_IN
  INSTAGRAM
  REFERRAL
  GOOGLE_MAPS
  TWOGIS
  WEBSITE
  OTHER

  @@schema("hub")
}

enum HubLeadStatus {
  NOT_CONTACTED
  CONTACTED
  DEMO_SCHEDULED
  DEMO_DONE
  TRIAL
  NEGOTIATING
  SIGNED
  LOST

  @@schema("hub")
}

enum HubClientPaymentStatus {
  ACTIVE
  OVERDUE
  CHURNED

  @@schema("hub")
}

enum HubProjectStatus {
  LEAD
  PROPOSAL
  NEGOTIATING
  IN_PROGRESS
  FROZEN
  DELIVERED
  PAID
  LOST

  @@schema("hub")
}

enum HubMilestoneStatus {
  PENDING
  INVOICED
  PAID

  @@schema("hub")
}

enum HubPaymentType {
  INCOME
  EXPENSE

  @@schema("hub")
}

enum HubPaymentCategory {
  PROJECT_REVENUE
  PRODUCT_REVENUE
  HOSTING
  DOMAINS
  OFFICE
  SMS_API
  MARKETING
  SALARY
  TRANSPORT
  TOOLS
  OTHER

  @@schema("hub")
}

enum HubCurrency {
  USD
  UZS

  @@schema("hub")
}

enum HubRecurringInterval {
  MONTHLY
  YEARLY

  @@schema("hub")
}

enum HubContactType {
  CLIENT
  REFERRAL_SOURCE
  POTENTIAL
  PARTNER

  @@schema("hub")
}

enum HubContactSource {
  PERSONAL
  IT_PARK
  TELEGRAM_GROUP
  INSTAGRAM
  REFERRAL
  OTHER

  @@schema("hub")
}

enum HubQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED

  @@schema("hub")
}

enum HubContractStatus {
  DRAFT
  SENT
  SIGNED

  @@schema("hub")
}

// --- Models ---

model HubUser {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String      @map("password_hash")
  role         HubUserRole @default(VIEWER)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("hub_users")
  @@schema("hub")
}

// Internal product roster. See the note on Product: this is deliberately a
// separate list from the public marketing one, not a copy of it.
model HubProduct {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  status      HubProductStatus @default(ACTIVE)
  description String?          @db.Text
  url         String?
  createdAt   DateTime         @default(now()) @map("created_at")

  leads    HubLead[]
  clients  HubClient[]
  payments HubPayment[]

  @@map("hub_products")
  @@schema("hub")
}

model HubLead {
  id            String        @id @default(cuid())
  productId     String        @map("product_id")
  name          String
  contactPerson String?       @map("contact_person")
  phone         String?
  telegram      String?
  instagram     String?
  address       String?
  district      String?
  source        HubLeadSource @default(OTHER)
  currentSystem String?       @map("current_system")
  status        HubLeadStatus @default(NOT_CONTACTED)
  lostReason    String?       @map("lost_reason")
  notes         String?       @db.Text
  firstContact  DateTime?     @map("first_contact")
  lastContact   DateTime?     @map("last_contact")
  followUp      DateTime?     @map("follow_up")
  createdAt     DateTime      @default(now()) @map("created_at")

  product HubProduct @relation(fields: [productId], references: [id])
  client  HubClient?

  @@map("hub_leads")
  @@schema("hub")
}

model HubClient {
  id            String                 @id @default(cuid())
  productId     String                 @map("product_id")
  leadId        String?                @unique @map("lead_id")
  name          String
  contactPerson String?                @map("contact_person")
  phone         String?
  plan          String?
  monthlyFee    Float?                 @map("monthly_fee")
  currency      HubCurrency            @default(USD)
  paymentStatus HubClientPaymentStatus @default(ACTIVE)
  startDate     DateTime?              @map("start_date")
  lastPayment   DateTime?              @map("last_payment")
  notes         String?                @db.Text
  createdAt     DateTime               @default(now()) @map("created_at")

  product  HubProduct   @relation(fields: [productId], references: [id])
  lead     HubLead?     @relation(fields: [leadId], references: [id])
  payments HubPayment[]

  @@map("hub_clients")
  @@schema("hub")
}

model HubProject {
  id                 String           @id @default(cuid())
  name               String
  type               String?
  status             HubProjectStatus @default(LEAD)
  clientContact      String?          @map("client_contact")
  clientPhone        String?          @map("client_phone")
  totalPrice         Float?           @map("total_price")
  currency           HubCurrency      @default(USD)
  upfrontPercent     Float?           @map("upfront_percent")
  referralSource     String?          @map("referral_source")
  referralFeePercent Float?           @map("referral_fee_percent")
  startDate          DateTime?        @map("start_date")
  deadline           DateTime?
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")

  milestones HubProjectMilestone[]
  payments   HubPayment[]
  quotes     HubQuote[]
  contract   HubContract?

  @@map("hub_projects")
  @@schema("hub")
}

model HubProjectMilestone {
  id        String             @id @default(cuid())
  projectId String             @map("project_id")
  title     String
  amount    Float
  currency  HubCurrency        @default(USD)
  status    HubMilestoneStatus @default(PENDING)
  dueDate   DateTime?          @map("due_date")
  paidDate  DateTime?          @map("paid_date")
  notes     String?            @db.Text

  project  HubProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments HubPayment[]

  @@map("hub_project_milestones")
  @@schema("hub")
}

model HubPayment {
  id                String                @id @default(cuid())
  type              HubPaymentType
  amount            Float
  currency          HubCurrency           @default(USD)
  category          HubPaymentCategory    @default(OTHER)
  projectId         String?               @map("project_id")
  productId         String?               @map("product_id")
  clientId          String?               @map("client_id")
  milestoneId       String?               @map("milestone_id")
  description       String
  date              DateTime              @default(now())
  recurring         Boolean               @default(false)
  recurringInterval HubRecurringInterval? @map("recurring_interval")
  notes             String?               @db.Text
  createdAt         DateTime              @default(now()) @map("created_at")

  project   HubProject?          @relation(fields: [projectId], references: [id])
  product   HubProduct?          @relation(fields: [productId], references: [id])
  client    HubClient?           @relation(fields: [clientId], references: [id])
  milestone HubProjectMilestone? @relation(fields: [milestoneId], references: [id])

  @@map("hub_payments")
  @@schema("hub")
}

model HubContact {
  id        String           @id @default(cuid())
  name      String
  company   String?
  role      String?
  phone     String?
  email     String?
  telegram  String?
  type      HubContactType   @default(POTENTIAL)
  source    HubContactSource @default(OTHER)
  notes     String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")

  quotes HubQuote[]

  @@map("hub_contacts")
  @@schema("hub")
}

model HubQuote {
  id              String         @id @default(cuid())
  projectId       String?        @map("project_id")
  contactId       String?        @map("contact_id")
  clientName      String         @map("client_name")
  clientPhone     String?        @map("client_phone")
  items           Json           @default("[]")
  basePrice       Float          @map("base_price")
  totalPrice      Float          @map("total_price")
  currency        HubCurrency    @default(USD)
  rushFeeApplied  Boolean        @default(false) @map("rush_fee_applied")
  rushFeePercent  Float?         @map("rush_fee_percent")
  discountPercent Float?         @map("discount_percent")
  status          HubQuoteStatus @default(DRAFT)
  validUntil      DateTime?      @map("valid_until")
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")

  project HubProject? @relation(fields: [projectId], references: [id])
  contact HubContact? @relation(fields: [contactId], references: [id])

  @@map("hub_quotes")
  @@schema("hub")
}

model HubContract {
  id               String            @id @default(cuid())
  projectId        String            @unique @map("project_id")
  clientName       String            @map("client_name")
  clientContact    String?           @map("client_contact")
  scopeDescription String?           @map("scope_description") @db.Text
  totalPrice       Float             @map("total_price")
  currency         HubCurrency       @default(USD)
  paymentTerms     String?           @map("payment_terms") @db.Text
  startDate        DateTime?         @map("start_date")
  deadline         DateTime?
  status           HubContractStatus @default(DRAFT)
  signedDate       DateTime?         @map("signed_date")
  notes            String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")

  project HubProject @relation(fields: [projectId], references: [id])

  @@map("hub_contracts")
  @@schema("hub")
}

model HubActivityLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  action     String // e.g., "created", "updated", "deleted"
  entityType String   @map("entity_type") // e.g., "project", "lead", "payment"
  entityId   String?  @map("entity_id")
  entityName String?  @map("entity_name")
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("hub_activity_logs")
  @@schema("hub")
}
