# Database (required)
# Local development: point this at a local Postgres, never at production.
# `docker compose up -d` starts one if you use Docker.
DATABASE_URL="postgresql://user:password@localhost:5432/necto"

# Session secrets (required — the apps refuse to start without them)
# There are no fallback values. Generate one per secret with:
#   openssl rand -base64 32
#
# ADMIN_SECRET     signs the `admin_session` cookie for apps/admin (the website CMS).
# HUB_ADMIN_SECRET signs the `hub_session` cookie for apps/hub (internal company system).
# Use two different values: Hub holds business records and must not be reachable
# with an admin CMS token.
ADMIN_SECRET=""
HUB_ADMIN_SECRET=""

# First-admin bootstrap (apps/admin /setup). Leave UNSET in normal operation:
# with no value the setup endpoint responds 404 and cannot create a user.
# Set it temporarily only to create the very first admin, then remove it.
#   openssl rand -base64 32
# ADMIN_SETUP_TOKEN=""

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://necto.uz

# Email Service (optional - for contact form)
# Using Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Telegram Bot (for inquiry bot)
# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_for_notifications

# Analytics. Each snippet in apps/web/src/app/layout.tsx renders only when its
# ID is set. NEXT_PUBLIC_* values are inlined at build time, so on Railway these
# must exist when the image is built — apps/web/Dockerfile declares a matching
# ARG for each. Setting them only as runtime variables has no effect.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_YM_ID=12345678
# NEXT_PUBLIC_META_PIXEL_ID=
