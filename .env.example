# Databases (required)
# Local development: point these at a local Postgres, never at production.
#
# DATABASE_URL     the public site and its CMS (apps/web, apps/admin).
# HUB_DATABASE_URL Necto Hub's own database (apps/hub). Deliberately a separate
#                  name: business records must not share storage with the CMS,
#                  and a distinct name makes a mix-up fail instead of silently
#                  writing to the wrong database.
DATABASE_URL="postgresql://user:password@localhost:5432/necto"
HUB_DATABASE_URL="postgresql://user:password@localhost:5432/necto_hub"

# Website -> Hub lead handover. The site has no access to Hub's database, so it
# posts enquiries to Hub over HTTP. Unset either value and no lead is created;
# the contact submission is still saved either way.
# On Railway, point the URL at the Hub service's private domain.
#   openssl rand -base64 32
HUB_INTAKE_URL="http://localhost:3001/api/leads/intake"
HUB_INTAKE_SECRET=""

# Session secrets (required — the apps refuse to start without them)
# There are no fallback values. Generate one per secret with:
#   openssl rand -base64 32
#
# ADMIN_SECRET     signs the `admin_session` cookie for apps/admin (the website CMS).
# HUB_ADMIN_SECRET signs the `hub_session` cookie for apps/hub (internal company system).
# Use two different values: Hub holds business records and must not be reachable
# with an admin CMS token.
ADMIN_SECRET=""
HUB_ADMIN_SECRET=""

# First-admin bootstrap (apps/admin /setup). Leave UNSET in normal operation:
# with no value the setup endpoint responds 404 and cannot create a user.
# Set it temporarily only to create the very first admin, then remove it.
#   openssl rand -base64 32
# ADMIN_SETUP_TOKEN=""

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://necto.uz

# Email Service (optional - for contact form)
# Using Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Telegram enquiry notifications (apps/web). Set both and a website enquiry
# is pushed to Telegram as soon as it is saved, so it does not wait to be
# noticed in Hub. Leave either unset and no message is sent — the enquiry is
# still saved and still handed to Hub.
#
# The bot only sends. There is no webhook and nothing receives messages.
#   TELEGRAM_BOT_TOKEN       from @BotFather
#   TELEGRAM_ADMIN_CHAT_ID   the chat to notify (your own user id is fine)
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_ADMIN_CHAT_ID=""

# Where the notification links for a Hub project. Defaults to
# https://hub.necto.uz; override so a local site does not link to production.
# HUB_PUBLIC_URL="http://localhost:3001"

# Analytics. Each snippet in apps/web/src/app/layout.tsx renders only when its
# ID is set. NEXT_PUBLIC_* values are inlined at build time, so on Railway these
# must exist when the image is built — apps/web/Dockerfile declares a matching
# ARG for each. Setting them only as runtime variables has no effect.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_YM_ID=12345678
# NEXT_PUBLIC_META_PIXEL_ID=
