{
  "name": "necto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@necto/web",
    "dev:hub": "turbo dev --filter=@necto/hub",
    "db:generate": "pnpm --filter @necto/db db:generate && pnpm --filter @necto/db-hub db:generate",
    "db:push": "pnpm --filter @necto/db db:push",
    "db:migrate": "pnpm --filter @necto/db db:migrate",
    "db:studio": "pnpm --filter @necto/db db:studio",
    "db:migrate:hub": "pnpm --filter @necto/db-hub db:migrate",
    "db:studio:hub": "pnpm --filter @necto/db-hub db:studio"
  },
  "devDependencies": {
    "railway": "^3.11.0",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.15.0"
}
