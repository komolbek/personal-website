{
  "name": "necto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/start.js",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@necto/web",
    "dev:hub": "turbo dev --filter=@necto/hub",
    "dev:api": "turbo dev --filter=@necto/api",
    "db:generate": "pnpm --filter @necto/db db:generate",
    "db:push": "pnpm --filter @necto/db db:push",
    "db:migrate": "pnpm --filter @necto/db db:migrate",
    "db:studio": "pnpm --filter @necto/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.15.0"
}
